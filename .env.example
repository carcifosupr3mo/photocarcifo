# === Photocarcifo - Configurazione ===
# Copia questo file in ".env" e modifica i valori.
# Genera SECRET_KEY con:  openssl rand -hex 32

SECRET_KEY=CAMBIAMI_con_openssl_rand_hex_32
PHOTO_ROOT=/mnt/magazzino
DATA_DIR=/opt/photocarcifo/data
SITE_NAME=Photocarcifo
SITE_URL=http://192.168.1.206
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIAMI_al_primo_avvio
THUMB_SMALL=400
THUMB_MEDIUM=1200
THUMB_QUALITY=82
SCAN_INTERVAL_MINUTES=10
SESSION_MAX_AGE=86400
# Quanto resta collegato chi ha spuntato "resta collegato su questo
# dispositivo" entrando: 90 giorni. Si sganciano tutti in una volta dal
# pannello, in Server > Sicurezza.
SESSION_MAX_AGE_LUNGO=7776000
RATE_LIMIT_LOGIN=50
USE_XACCEL=true
# Chiave IndexNow (vedi app/indexnow.py), notifica a Bing/IndexNow quando
# una pagina pubblica cambia. Genera la tua con:
#   python3 -c "import secrets; print(secrets.token_hex(16))"
# Vuota = IndexNow disattivato. Non e' un segreto da proteggere: lo
# standard la vuole leggibile pubblicamente su /<chiave>.txt.
INDEXNOW_KEY=

# === Lettura automatica dei numeri di gara ===
OCR_ENABLED=true
# Lato lungo in px per l'analisi (1800 = misura delle miniature in cache)
OCR_MAX_SIDE=1800
# Sicurezza minima della lettura (0-1). Tarato sulle foto vere: sotto 0.95
# le letture sono quasi tutte sbagliate, sopra sono affidabili
OCR_MIN_CONFIDENCE=0.95
# Altezza minima del numero sulla foto. Bassa apposta: i piloti lontani
# hanno tabelle alte l'1% dell'immagine
OCR_MIN_HEIGHT_RATIO=0.008
# Cifre minime e massime di un numero di gara
OCR_MIN_DIGITS=1
# Cartelle dove le cifre singole sono numeri di corsia e non tabelle
OCR_NIENTE_CIFRE_SINGOLE=ATLETICA
OCR_MAX_DIGITS=4
# Foto lette a ogni passata del timer di sistema
OCR_BATCH_SIZE=4000
# Processi in parallelo: 0 = decide da solo in base a core e memoria libera.
# Il limite pratico e' la CPU, non la memoria: oltre un processo per core
# non si guadagna nulla
OCR_WORKERS=0
# Memoria stimata per processo, misurata sul campo
OCR_MB_PER_WORKER=550

# Cartella da leggere per prima (le altre vengono dopo). Vuoto = nessuna priorita'
OCR_PRIORITA=BMX
